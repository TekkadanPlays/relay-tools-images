#!/usr/bin/bash
# get paths for scripts, the repo parent dir and app name
SD=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
APP="$(basename $SD)"
RD="$(dirname "$SD")"
PASSWORD=creator
echo $PASSWORD>$RD/$APP.passwd
cp -rfpu $RD/debian /var/lib/machines/$APP
mkdir -p /var/lib/machines/$APP/app
mkdir -p /srv/oni
cp $SD/nspawn /etc/systemd/nspawn/$APP.nspawn
sed -i 's/\r$//' /etc/systemd/nspawn/$APP.nspawn
cp $SD/app.service /var/lib/machines/$APP/lib/systemd/system/app.service
cp $SD/ome.service /var/lib/machines/$APP/lib/systemd/system/ome.service
cp $SD/deploy.service /var/lib/machines/$APP/lib/systemd/system/deploy.service
cp $SD/deploy.timer /var/lib/machines/$APP/lib/systemd/system/deploy.timer
cp $SD/deploy.sh /var/lib/machines/$APP/usr/local/bin/deploy.sh
# Strip Windows CRLF line endings that break script execution
sed -i 's/\r$//' /var/lib/machines/$APP/lib/systemd/system/app.service
sed -i 's/\r$//' /var/lib/machines/$APP/lib/systemd/system/ome.service
sed -i 's/\r$//' /var/lib/machines/$APP/lib/systemd/system/deploy.service
sed -i 's/\r$//' /var/lib/machines/$APP/lib/systemd/system/deploy.timer
sed -i 's/\r$//' /var/lib/machines/$APP/usr/local/bin/deploy.sh
systemd-nspawn --pipe -q -D /var/lib/machines/$APP /usr/bin/bash << EOF
	echo -e "$PASSWORD\n$PASSWORD" | passwd
	echo "$APP">/etc/hostname

	export DEBIAN_FRONTEND=noninteractive
	apt update
	apt -y install --no-install-suggests git curl unzip ca-certificates gnupg

	# Install Docker (for OvenMediaEngine container)
	install -m 0755 -d /etc/apt/keyrings
	curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
	chmod a+r /etc/apt/keyrings/docker.gpg
	echo "deb [arch=\$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" > /etc/apt/sources.list.d/docker.list
	apt update
	apt -y install docker-ce docker-ce-cli containerd.io

	# Install Bun (for Mycelium Live web server + frontend build)
	curl -fsSL https://bun.sh/install | bash
	ln -sf /root/.bun/bin/bun /usr/local/bin/bun
	ln -sf /root/.bun/bin/bunx /usr/local/bin/bunx

	# Pre-pull OME Docker image so first deploy is faster
	systemctl start docker || true
	docker pull airensoft/ovenmediaengine:latest || true
	systemctl stop docker || true

	# Note: repo clone + build happens on first boot via deploy.timer
	# because /app is bind-mounted from /srv/oni at runtime
	systemctl enable app
	systemctl enable ome
	systemctl enable docker
	systemctl enable deploy.timer
EOF
systemctl stop systemd-nspawn@$APP
