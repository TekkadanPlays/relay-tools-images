# Copy this file to .env and fill in values, then run: source .env
# The defaults below match setup.sh and compose.yaml: Postgres on host port 5455 (maps to 5432 in the container).

export POSTGRES_HOST=localhost
export POSTGRES_PORT=5455
export POSTGRES_USER=postgres
export POSTGRES_PASSWORD=postgres
export POSTGRES_DB=gc_index_relay_dev
export REQUIRE_DB=true

# Optional — only if you use docker compose for setup/migrator/mercury (override compose defaults):
# export POSTGRES_RUNTIME_USER=gc_index_relay
# export POSTGRES_RUNTIME_PASSWORD=gc_index_relay_runtime
# export SECRET_KEY_BASE="$(mix phx.gen.secret)"

# ── Admin authentication ──
# API key for server-to-server admin operations (scripts, cron, federation sync).
# Generate with: openssl rand -hex 32
# export MERCURY_ADMIN_API_KEY="sk_live_..."

# Fallback admin pubkeys (comma-separated 64-char hex). Used for lockout recovery.
# These bypass the DB-based admin check. Leave empty for first-claim bootstrap.
# export MERCURY_ADMIN_PUBKEYS=""

# ── NIP-29 Relay Keys ──
# 64-character hex keys used by the relay to sign NIP-29 group metadata (kind 39000).
# Generate with a nostr tool or openssl.
# export MERCURY_RELAY_PUBKEY="your_64_char_hex_public_key"
# export MERCURY_RELAY_PRIVKEY="your_64_char_hex_private_key"
