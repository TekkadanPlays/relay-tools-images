#!/usr/bin/bash
# get paths for scripts, the repo parent dir and app name
SD=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
APP="$(basename $SD)"
RD="$(dirname "$SD")"
PASSWORD=creator
echo $PASSWORD>$RD/$APP.passwd
cp -rfpu $RD/debian /var/lib/machines/$APP
mkdir -p /var/lib/machines/$APP/data
mkdir -p /srv/ergo
cp $SD/nspawn /etc/systemd/nspawn/$APP.nspawn
sed -i 's/\r$//' /etc/systemd/nspawn/$APP.nspawn
cp $SD/app.service /var/lib/machines/$APP/lib/systemd/system/app.service
sed -i 's/\r$//' /var/lib/machines/$APP/lib/systemd/system/app.service
systemd-nspawn --pipe -q -D /var/lib/machines/$APP /usr/bin/bash << EOF
	echo -e "$PASSWORD\n$PASSWORD" | passwd
	echo "$APP">/etc/hostname

	export DEBIAN_FRONTEND=noninteractive
	apt update
	apt -y install --no-install-suggests wget

	# Install Ergo IRC server (pre-built binary)
	ERGO_VERSION=2.14.0
	ARCH=\$(uname -m)
	case \$ARCH in
		aarch64|arm64) ERGO_ARCH="linux-arm64" ;;
		x86_64) ERGO_ARCH="linux-amd64" ;;
		*) echo "Unsupported arch: \$ARCH"; exit 1 ;;
	esac
	wget -q "https://github.com/ergochat/ergo/releases/download/v\${ERGO_VERSION}/ergo-\${ERGO_VERSION}-\${ERGO_ARCH}.tar.gz" -O /tmp/ergo.tar.gz
	tar xzf /tmp/ergo.tar.gz -C /tmp
	cp /tmp/ergo-\${ERGO_VERSION}-\${ERGO_ARCH}/ergo /usr/local/bin/ergo
	chmod +x /usr/local/bin/ergo
	rm -rf /tmp/ergo* 

	systemctl enable app
EOF
systemctl stop systemd-nspawn@$APP
