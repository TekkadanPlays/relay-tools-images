[Unit]
Description=CoinOS Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/app
ExecStart=/usr/local/bin/bun run /app/index.ts
Restart=on-failure
RestartSec=10
Environment=HOST=0.0.0.0
Environment=PORT=3119
Environment=URL=https://mycelium.social
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
