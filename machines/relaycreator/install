#!/usr/bin/bash
# get paths for scripts, the repo parent dir and app name
SD=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
APP="$(basename $SD)"
RD="$(dirname "$SD")"
PASSWORD=creator
echo $PASSWORD>$RD/$APP.passwd
cp -rfpu $RD/debian /var/lib/machines/$APP
mkdir -p /var/lib/machines/$APP/app
mkdir -p /srv/relaycreator
cp $SD/nspawn /etc/systemd/nspawn/$APP.nspawn
sed -i 's/\r$//' /etc/systemd/nspawn/$APP.nspawn
cp $SD/app.service /var/lib/machines/$APP/lib/systemd/system/app.service
cp $SD/wallet-service.service /var/lib/machines/$APP/lib/systemd/system/wallet-service.service
cp $SD/deploy.service /var/lib/machines/$APP/lib/systemd/system/deploy.service
cp $SD/deploy.timer /var/lib/machines/$APP/lib/systemd/system/deploy.timer
cp $SD/deploy.sh /var/lib/machines/$APP/usr/local/bin/deploy.sh
# Strip Windows CRLF line endings that break script execution
sed -i 's/\r$//' /etc/systemd/nspawn/$APP.nspawn
sed -i 's/\r$//' /var/lib/machines/$APP/lib/systemd/system/app.service
sed -i 's/\r$//' /var/lib/machines/$APP/lib/systemd/system/wallet-service.service
sed -i 's/\r$//' /var/lib/machines/$APP/lib/systemd/system/deploy.service
sed -i 's/\r$//' /var/lib/machines/$APP/lib/systemd/system/deploy.timer
sed -i 's/\r$//' /var/lib/machines/$APP/usr/local/bin/deploy.sh
systemd-nspawn --pipe -q -D /var/lib/machines/$APP /usr/bin/bash << EOF
	export PATH=/usr/local/go/bin:$PATH
	echo -e "$PASSWORD\n$PASSWORD" | passwd
	echo "$APP">/etc/hostname
	apt update
	apt -y install git curl build-essential pkg-config libssl-dev
	curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
	apt -y install nodejs
	
	# Install Rust
	curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
	source ~/.cargo/env
	
	cd /app
	git clone https://github.com/TekkadanPlays/relaycreator.git /app
	npm install -g pnpm@9
	npm install -g prisma

	# Build Express API server
	cd /app/api-server
	pnpm install
	npx prisma generate

	# Build React SPA
	cd /app/web
	pnpm install
	npx vite build

	# Build API server (TypeScript -> JS)
	cd /app/api-server
	npx tsc
	
	# Build Rust wallet service
	cd /app
	mkdir -p /app/wallet-service
	# Copy wallet service files from current repo
	cp -r /app/machines/../wallet-service/* /app/wallet-service/ 2>/dev/null || echo "Wallet service files not found, creating minimal structure"
	cd /app/wallet-service
	if [ -f "Cargo.toml" ]; then
		~/.cargo/bin/cargo build --release
		install -m 0755 target/release/wallet-service /usr/local/bin/
	else
		echo "Creating minimal wallet service structure..."
		mkdir -p src/{bin,grpc_service,http_service,database,models,bitcoin}
		# Create basic files if they don't exist
		[ ! -f "Cargo.toml" ] && echo "Wallet service source not available, skipping build"
	fi

	systemctl enable app
	systemctl enable wallet-service
	systemctl enable deploy.timer
EOF
systemctl stop systemd-nspawn@$APP
